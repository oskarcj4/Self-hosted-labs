#!/usr/bin/env python3
"""Servidor de estado remoto para el backend "http" de Terraform (como el de GitLab).

  GET    /state/<nombre>   estado actual (404 si no hay)
  POST   /state/<nombre>   guarda el estado (?ID=<lock> debe coincidir si hay bloqueo)
  DELETE /state/<nombre>   borra el estado
  LOCK   /state/<nombre>   toma el bloqueo (423 + info del bloqueo actual si ya está tomado)
  UNLOCK /state/<nombre>   suelta el bloqueo (cuerpo vacío = force-unlock)

Uso: tf-state-server <directorio> [puerto]
"""
import json, os, re, sys
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from urllib.parse import urlparse, parse_qs

DIR = sys.argv[1] if len(sys.argv) > 1 else "/var/lib/tfstate"
PORT = int(sys.argv[2]) if len(sys.argv) > 2 else 8500
os.makedirs(DIR, exist_ok=True)


class H(BaseHTTPRequestHandler):
    def _name(self):
        m = re.fullmatch(r"/state/([A-Za-z0-9._-]+)", urlparse(self.path).path)
        return m.group(1) if m else None

    def _paths(self, n):
        return os.path.join(DIR, n + ".tfstate"), os.path.join(DIR, n + ".lock")

    def _send(self, code, body=b"", ctype="application/json"):
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def _body(self):
        n = int(self.headers.get("Content-Length") or 0)
        return self.rfile.read(n) if n else b""

    def _lock(self, n):
        try:
            return open(self._paths(n)[1], "rb").read()
        except FileNotFoundError:
            return None

    def do_GET(self):
        n = self._name()
        if not n:
            return self._send(404)
        try:
            self._send(200, open(self._paths(n)[0], "rb").read())
        except FileNotFoundError:
            self._send(404)

    def do_POST(self):
        n = self._name()
        if not n:
            return self._send(404)
        lk = self._lock(n)
        lid = parse_qs(urlparse(self.path).query).get("ID", [None])[0]
        if lk and json.loads(lk).get("ID") != lid:
            return self._send(423, lk)
        open(self._paths(n)[0], "wb").write(self._body())
        self._send(200)

    def do_DELETE(self):
        n = self._name()
        if n:
            try:
                os.remove(self._paths(n)[0])
            except FileNotFoundError:
                pass
        self._send(200)

    def do_LOCK(self):
        n = self._name()
        if not n:
            return self._send(404)
        body = self._body()
        lk = self._lock(n)
        if lk:
            return self._send(423, lk)
        open(self._paths(n)[1], "wb").write(body)
        self._send(200, body)

    def do_UNLOCK(self):
        n = self._name()
        if not n:
            return self._send(404)
        body = self._body()
        lk = self._lock(n)
        if lk and body:
            if json.loads(body).get("ID") != json.loads(lk).get("ID"):
                return self._send(409, lk)
        try:
            os.remove(self._paths(n)[1])
        except FileNotFoundError:
            pass
        self._send(200)

    def log_message(self, fmt, *a):
        sys.stderr.write("tfstate: " + (fmt % a) + "\n")


if __name__ == "__main__":
    ThreadingHTTPServer(("127.0.0.1", PORT), H).serve_forever()
