# Lab 61 — dns-01 (dnsmasq) y pagos-01 (API): servidores mínimos sin terminal.
FROM debian:12-slim
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends dnsmasq python3 \
    && rm -rf /var/lib/apt/lists/*
COPY setup-node/ /opt/node/
RUN chmod 0755 /opt/node/node.sh
CMD ["/opt/node/node.sh"]
