# Resolver "de la wifi de invitados" del lab 126: reenvía todo al DNS
# interno salvo el portal, que lo manda a otro sitio.
FROM alpine:3.20
RUN apk add --no-cache dnsmasq
CMD ["dnsmasq", "-k", "--no-resolv", "--server=10.126.0.53", "--address=/portal.empresa.lab/10.126.0.66", "--log-queries", "--log-facility=-"]
