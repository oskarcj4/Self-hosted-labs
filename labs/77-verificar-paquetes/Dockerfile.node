# Lab 77 — artifacts.interno: mirror HTTP de artefactos, sin terminal.
FROM debian:12-slim
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends gnupg python3 \
    && rm -rf /var/lib/apt/lists/*
COPY setup-node/ /opt/node/
RUN chmod 0755 /opt/node/node.sh
CMD ["/opt/node/node.sh"]
