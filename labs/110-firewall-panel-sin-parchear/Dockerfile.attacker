# Caja atacante (modo red). Herramientas de red + cliente HTTP, SIN acceso al
# target ni a las banderas: hay que cruzar el firewall por el panel sin parchear.
FROM debian:12-slim
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
      curl nmap ncat netcat-openbsd python3 iproute2 iputils-ping \
      openssh-client dnsutils jq grep less vim-tiny ca-certificates \
    && rm -rf /var/lib/apt/lists/*
RUN curl -fsSL https://github.com/tsl0922/ttyd/releases/download/1.7.7/ttyd.x86_64 \
      -o /usr/local/bin/ttyd && chmod +x /usr/local/bin/ttyd
# Caja del atacante: eres root en TU máquina (como en HTB). Hace falta para
# lanzar sondas con nmap.
COPY setup/attacker-motd.sh /etc/profile.d/zz-motd.sh
RUN chmod 0644 /etc/profile.d/zz-motd.sh
WORKDIR /root
CMD exec ttyd -p 7681 -W -t fontSize=14 bash -l
